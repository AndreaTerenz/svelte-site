		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14"
	},
	"dependencies": {
		"bootstrap-icons": "^1.13.1",
		"p5": "^2.2.3",
		"svelte-i18n": "^4.0.1",
		"svelte-p5": "^0.3.0",
		"svelte-typed-js": "^1.0.3"
	}
